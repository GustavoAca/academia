{
  "name": "academia-nativo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PWA de controle de treinos — site 100% estático, sem dependências de runtime.",
  "scripts": {
    "test": "node --test \"tests/*.test.js\"",
    "test:watch": "node --test --watch \"tests/*.test.js\"",
    "validar": "node scripts/validar-biblioteca.mjs",
    "dump": "node scripts/dump-biblioteca.mjs",
    "serve": "npx serve ."
  },
  "engines": {
    "node": ">=20.19"
  }
}
